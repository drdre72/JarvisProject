# jarvis-core supervisor configuration (ADR-0006).
# Copy to the repository root as jarvis-core.toml.

[rust_core]
# Master switch. false = the binary exits immediately and the legacy Python
# runtime is the only thing that runs (default; Stage A rollout).
enabled = false
# Evaluate and journal every decision but never dispatch a consequential
# action. Keep true until Stage B.
shadow_mode = true
# Operational data directory for the SQLite journal. `logs/` is gitignored.
# This is operational memory — NOT the personal/semantic Markdown vault.
data_dir = "logs/rust-core"
event_queue_capacity = 256
dedup_window_seconds = 30
max_payload_bytes = 16384
per_source_burst = 32
# Stage B gate. false = every request frame is answered `ipc_disabled`;
# true = the limited IPC surface (obligation scheduling) accepts work.
ipc_requests = false
# Stage B gate for the inference-lifecycle function specifically.
# false = `run_inference`/`cancel_inference` are answered
# `inference_disabled` and Python keeps its own subprocess path — the
# rollback. true = the supervisor spawns/kills the configured binary.
inference_relay = false

[inference]
# The binary the supervisor may spawn; workers send argv only.
binary = "bin/llama-completion.exe"
default_timeout_seconds = 120
# Hard ceiling on any request-side timeout.
max_timeout_seconds = 300
# Single-flight matches the serialized turn pipeline today.
max_concurrent = 1
max_argv_count = 64
# The prompt travels inside argv; this caps its total size on the wire.
max_argv_bytes = 49152
# stdout is the payload: over-cap kills the child as output_overflow.
max_stdout_bytes = 32768
# stderr is diagnostics: fully drained, only this many tail bytes retained
# (llama.cpp -v emits ~0.5 MiB per run — a cap here must never kill).
max_stderr_bytes = 65536

[scheduler]
tick_seconds = 1
# Hard cap on overdue work released per tick.
max_due_per_tick = 8

[workers]
heartbeat_timeout_seconds = 30
max_restart_attempts = 3
base_backoff_ms = 500
max_backoff_ms = 30000
